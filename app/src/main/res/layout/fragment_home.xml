<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/app_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        style="@style/Toolbar.Styles"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_home"
        app:title="@string/toolbarHome" />
    <ScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tvMainCard"
                style="@style/Card.Hero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/large_margin"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
            >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/hero_card_padding">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/heroTitle"
                        style="@style/Text.HeroTitle"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/heroSubTitle"
                        style="@style/Text.HeroSubtitle"
                        android:layout_marginTop="@dimen/small_margin"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/tvSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/summaryTitle"
                app:layout_constraintTop_toBottomOf="@id/tvMainCard"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="@id/tvMainCard"
                style="@style/Text.SectionTitle"
                />
            <GridLayout
                android:id="@+id/tvSummaryContainer"
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvSummaryTitle"
                app:layout_constraintStart_toStartOf="@id/tvSummaryTitle"
                app:layout_constraintEnd_toEndOf="@id/tvMainCard"
                android:columnCount="2"
                android:rowCount="3"
                >
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTotalWorks"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding"
                        >
                        <TextView
                            android:id="@+id/tvTotalWorkoutsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.StatNumber"
                            tools:text="18" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.StatLabel"
                            android:text="@string/totalWorkoutsLabel"
                        />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMonthWorks"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding"
                        >
                        <TextView
                            android:id="@+id/tvMonthWorkoutsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.StatNumber"
                            tools:text="5" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.StatLabel"
                            android:text="@string/totalMonthLabel"
                            />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLastWeight"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="5dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding"
                        >
                        <TextView
                            android:id="@+id/tvLastWeightValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.StatNumber"
                            tools:text="72.5" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.StatLabel"
                            android:text="@string/lastWeightLabel"
                            />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLastPain"
                style="@style/Card.Default"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding"
                    >
                    <TextView
                        android:id="@+id/tvRecentPainValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.StatNumber"
                        tools:text="1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/Text.StatLabel"
                        android:text="@string/recentPainLabel"
                        />
                </LinearLayout>

                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLastTrain"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_columnSpan="2"
                    android:layout_margin="5dp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/card_padding">

                        <TextView
                            android:id="@+id/tvTitleLastWork"
                            style="@style/Text.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Last Workout"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/tvPainTag" />

                        <TextView
                            android:id="@+id/tvPainTag"
                            style="@style/Text.PainTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pain"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <TextView
                            android:id="@+id/tvDatePain"
                            style="@style/Text.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/tvTitleLastWork"
                            app:layout_constraintStart_toStartOf="parent"
                            tools:text="13/05/2026" />

                        <TextView
                            android:id="@+id/tvLastWorkoutSummary"
                            style="@style/Text.StatLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minLines="1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            app:layout_constraintTop_toBottomOf="@id/tvDatePain"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:text="Chest and triceps · 72.5 kg · Right Wrist" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
            <TextView
                android:id="@+id/tvAccessTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/accessTitle"
                app:layout_constraintTop_toBottomOf="@id/tvSummaryContainer"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="@id/tvMainCard"
                style="@style/Text.SectionTitle"
                />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvAccessTitle"
                app:layout_constraintStart_toStartOf="@id/tvMainCard"
                app:layout_constraintEnd_toEndOf="@id/tvMainCard"
                >
                    <Button
                        android:id="@+id/btnAddWorkout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        style="@style/Button.Primary"
                        android:text="@string/addWorkout" />
                    <Button
                        android:id="@+id/btnWorkoutHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        style="@style/Button.Secondary"
                        android:text="@string/checkHistory" />
<!--                    <Button-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_gravity="center"-->
<!--                        style="@style/Button.Secondary"-->
<!--                        android:text="@string/checkCalendar" />-->

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>